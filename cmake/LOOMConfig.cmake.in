@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The installed loom::httplib target (a FetchContent-built third-party dep in
# the LOOMTargets export) references Threads::Threads, ZLIB::ZLIB and
# Brotli::* in its INTERFACE_LINK_LIBRARIES — httplib's compression and
# OpenSSL support, enabled by default when the system has the libs. Its
# INTERFACE_COMPILE_DEFINITIONS propagate CPPHTTPLIB_BROTLI_SUPPORT /
# CPPHTTPLIB_ZLIB_SUPPORT, so the cc_* objects were compiled against those
# symbols and a consumer link needs them resolved. Re-find all three so the
# export is self-contained. CMake ships no FindBrotli module, so httplib's
# own cmake/FindBrotli.cmake is installed next to this file; append this
# directory to CMAKE_MODULE_PATH (APPEND, not PREPEND, so a consumer's own
# module path still wins) before finding it.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(Threads)
find_dependency(ZLIB)
find_dependency(Brotli COMPONENTS encoder decoder common)

# Re-find externally-provided dependencies that consumers need.
# CURL and OpenSSL are system packages; the FetchContent-built deps
# (yyjson/uv_a/httplib/ftxui-screen) are installed as targets in the
# LOOMTargets export itself, so they are NOT find_dependency'd here.
find_dependency(CURL)
find_dependency(OpenSSL)

include("${CMAKE_CURRENT_LIST_DIR}/LOOMTargets.cmake")

# The package is `loom` (installed as loomConfig.cmake); components would be
# checked against loom_<component>_FOUND. No components are defined today.
check_required_components(loom)
