  "stage": "1-3: state layout envelope, click bindings, font-style, crossing retry",
  "admission": {
    "envelope": "relations_layout enables the two-pool meter for RelationFamily::State from the actual canvas: state_envelope_layout_allowance(w,h) = w*h*192 + 4096",
    "click": "`click <id> \"<url>\" [\"<tooltip>\"]`: closed grammar, declared-target resolution, consumed and dropped (FS-2)",
    "font-style": "`font-style: italic|normal` validated and dropped",
    "crossing": "a failed state routing pass is undone from a pre-image log and retried once with perpendicular crossings and no free-region label prefilter; the retry is inert when the first pass succeeds"
  },
