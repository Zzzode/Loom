      "source_sha256": "2a62c46194efe95b1cd64293ca15b7fd07a4b02c8359ebc7091c6e8a364db49b",
      "classic_model_json": "{\"direction\":\"TB\",\"nodes\":[[\"A\",{\"id\":\"A\",\"label\":\"Client\",\"shape\":\"rectangle\"}],[\"B\",{\"id\":\"B\",\"label\":\"Cache\",\"shape\":\"rectangle\"}],[\"C\",{\"id\":\"C\",\"label\":\"API\",\"shape\":\"rectangle\"}],[\"D\",{\"id\":\"D\",\"label\":\"Database\",\"shape\":\"cylinder\"}],[\"E\",{\"id\":\"E\",\"label\":\"Auth Service\",\"shape\":\"rectangle\"}],[\"F\",{\"id\":\"F\",\"label\":\"Sessions\",\"shape\":\"cylinder\"}]],\"edges\":[{\"source\":\"A\",\"target\":\"B\",\"label\":\"\",\"style\":\"solid\",\"hasArrowStart\":false,\"hasArrowEnd\":true},{\"source\":\"C\",\"target\":\"D\",\"label\":\"\",\"style\":\"solid\",\"hasArrowStart\":false,\"hasArrowEnd\":true},{\"source\":\"E\",\"target\":\"F\",\"label\":\"\",\"style\":\"solid\",\"hasArrowStart\":false,\"hasArrowEnd\":true},{\"source\":\"B\",\"target\":\"C\",\"label\":\"\",\"style\":\"solid\",\"hasArrowStart\":false,\"hasArrowEnd\":true},{\"source\":\"B\",\"target\":\"E\",\"label\":\"\",\"style\":\"solid\",\"hasArrowStart\":false,\"hasArrowEnd\":true}],\"subgraphs\":[{\"id\":\"Frontend\",\"label\":\"Frontend\",\"direction\":\"\",\"nodeIds\":[\"A\",\"B\"],\"children\":[]},{\"id\":\"Backend\",\"label\":\"Backend\",\"direction\":\"\",\"nodeIds\":[\"C\",\"D\"],\"children\":[]},{\"id\":\"Auth\",\"label\":\"Auth\",\"direction\":\"\",\"nodeIds\":[\"E\",\"F\"],\"children\":[]}]}",
      "classic_model_sha256": "51f697442947715e22e0f06754a2c252d71283e9c594149f70b1470001f01cc0",
