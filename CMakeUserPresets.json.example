{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "local-linux-clang23",
      "displayName": "Local Linux dev box (Homebrew LLVM 23 + brew glibc)",
      "description": "Machine-local preset — NOT for CI. The committed presets target GitHub's macos-14 runner. On Linux you need an explicit LLVM 23 toolchain, system (not Homebrew) OpenSSL/curl headers, and a link line against Homebrew's glibc. Replace <LLVM_PREFIX> and <BREW_PREFIX> with your own paths. LLVM 23 is required: LLVM 22 has an operator-new ambiguity bug (LLVM #184957) and an optimizer SIGSEGV that block this tree.",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/clang23-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "<LLVM_PREFIX>/bin/clang",
        "CMAKE_CXX_COMPILER": "<LLVM_PREFIX>/bin/clang++",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "<LLVM_PREFIX>/bin/clang-scan-deps",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++ -isystem <LLVM_PREFIX>/include/c++/v1",
        "CMAKE_CXX_FLAGS_DEBUG": "-g0",
        "CMAKE_PREFIX_PATH": "/usr",
        "CMAKE_IGNORE_PREFIX_PATH": "<BREW_PREFIX>",
        "OPENSSL_ROOT_DIR": "/usr",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -L<LLVM_PREFIX>/lib -L<BREW_PREFIX>/opt/glibc/lib -Wl,-rpath,<LLVM_PREFIX>/lib -Wl,-rpath,<BREW_PREFIX>/opt/glibc/lib -Wl,-dynamic-linker,<BREW_PREFIX>/opt/glibc/lib/ld-linux-x86-64.so.2 -Wl,--allow-shlib-undefined"
      }
    },
    {
      "name": "local-linux-clang23-release",
      "displayName": "Local Linux dev box — LLVM 23 Release",
      "description": "As local-linux-clang23, but Release with -O2. LLVM 23 fixed the optimizer crash that forced -O0 on LLVM 22.",
      "inherits": "local-linux-clang23",
      "binaryDir": "${sourceDir}/build/clang23-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local-linux-clang23",
      "configurePreset": "local-linux-clang23"
    },
    {
      "name": "local-linux-clang23-release",
      "configurePreset": "local-linux-clang23-release"
    }
  ],
  "testPresets": [
    {
      "name": "local-linux-clang23",
      "configurePreset": "local-linux-clang23",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "local-linux-clang23-release",
      "configurePreset": "local-linux-clang23-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
